# Caddy in front of the shop: HTTPS with a Let's Encrypt certificate that renews by itself, a redirect from HTTP,
# the built frontend, and /api to the backend. The values come from the server's .env through compose.yml.
#
# Who gets in is one switch, SHOP_ACCESS in the server's .env:
#
#   preview  (the default) The closed preview of phase 7: one shared login for every page, and search engines are
#            kept out with an X-Robots-Tag header and a robots.txt that disallows everything.
#   unlisted Online without that login, but not open yet: search engines are kept out like in the preview, and the
#            backend only lets admins order (SalesGate), so nobody "pays" with Stripe's test cards.
#   open     The live shop: no login, and search engines get the shop's own robots.txt and sitemap.
#
# Ads are a second switch, ADS: "off" (the default) or "adsense". It only changes the Content-Security-Policy, which
# has to let Google's ad scripts and frames in. The backend reads the same value and tells the app whether to show ads.
#
# Open the shop only after the legal check, with /opt/poketopia/bin/shop-access.sh (see docs/phases/phase-10.md).
# Any other value stops Caddy from starting, so a typo never opens the shop. The lines that differ between the modes
# are the snippets marked "preview" below and their "unlisted" and "open" twins; everything else is the same.

# Security headers. Also used for the error pages below, because Caddy doesn't add them to an error by itself.
(headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The shop's own pages may use the camera, for the live camera view of the card scanner on a computer.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), usb=()"
		-Server
	}
	import {$ADS:off}_csp
	import {$SHOP_ACCESS:preview}_headers
}

# Without ads. Card images come from the card sources (TCGdex, Scryfall, Lorcast, OPTCG) and uploads, so images may
# come from any https address. Scripts, styles, fonts and API calls only from the shop itself.
(off_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# With Google AdSense: the same, plus Google's ad scripts, frames and calls. Google publishes no list of its
# addresses, so this one comes from what AdSense is known to use. When ads are first switched on, open a card page
# with the browser console open: a blocked address shows there as a Content-Security-Policy error, and belongs here.
(adsense_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://*.googlesyndication.com https://*.googletagservices.com https://*.doubleclick.net https://*.google.com https://*.gstatic.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; fenced-frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# preview: keep search engines out
(preview_headers) {
	header X-Robots-Tag "noindex, nofollow"
}

(unlisted_headers) {
	header X-Robots-Tag "noindex, nofollow"
}

(open_headers) {
}

(preview_gate) {
	# preview: readable without the login, so search engines can see they aren't welcome
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "User-agent: *
Disallow: /
"
	}

	# preview: one shared login for every other page
	@login not path /robots.txt
	basic_auth @login {
		{$PREVIEW_USER} {$PREVIEW_PASSWORD_HASH}
	}
}

# unlisted: no login, and search engines are kept out like in the preview. Two exceptions, so an AdSense account can
# be approved before the shop opens: Google's ad crawler (Mediapartners-Google, which reads pages to pick ads and
# doesn't put anything in search) may read every page, and any crawler may read /ads.txt.
(unlisted_gate) {
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "User-agent: Mediapartners-Google
Allow: /

User-agent: *
Allow: /ads.txt
Disallow: /
"
	}
}

(open_gate) {
}

# SITE_ALIASES (optional): more addresses, such as www.<domain> or the old preview address, that redirect to
# SITE_ADDRESS. Caddy gets a certificate for each of them too.
{$SITE_ADDRESS} {$SITE_ALIASES} {
	encode zstd gzip
	import headers

	@alias not host {$SITE_ADDRESS}
	redir @alias https://{$SITE_ADDRESS}{uri} 308

	import {$SHOP_ACCESS:preview}_gate

	handle {
		# The shop has its own login with a cookie: the backend never sees the preview login.
		request_header -Authorization

		# For search engines and link previews, which don't run JavaScript: the sitemap, robots.txt, and the product,
		# drop and news pages with their own title, text and picture, come from the backend. While the preview runs,
		# robots.txt is answered above.
		handle /sitemap.xml {
			rewrite * /api/v1/seo/sitemap.xml
			reverse_proxy backend:8080
		}
		handle /robots.txt {
			rewrite * /api/v1/seo/robots.txt
			reverse_proxy backend:8080
		}
		# For ad networks: which account may sell ads on this site. The backend answers 404 while there are no ads.
		handle /ads.txt {
			rewrite * /api/v1/seo/ads.txt
			reverse_proxy backend:8080
		}
		@sharePage path_regexp ^/(product|drops|nieuws)/[^/]+$
		handle @sharePage {
			rewrite * /api/v1/seo/pages{path}
			reverse_proxy backend:8080 {
				# An unknown page: the app shows its own 404 page. Caddy's copy of index.html also covers a backend
				# that can't read its own, which would otherwise answer an empty page.
				@notFound status 404
				handle_response @notFound {
					root * /srv
					rewrite * /index.html
					file_server {
						status 404
					}
				}
			}
		}

		handle /api/* {
			# Request bodies: uploads are multipart, up to 6 MB in the backend. They are admin's images and CSV import,
			# and a customer's photos for the card scanner and the pre-grade check (two photos), which are often
			# larger than 256 kB from a phone. Everything else is JSON, 256 kB at most (app.http.max-body-size).
			# Larger ones get 413 before they reach the backend. A new upload outside admin needs its path here.
			@upload {
				path /api/v1/admin/* /api/v1/scanner /api/v1/pregrade
				header Content-Type multipart/form-data*
			}
			@notUpload not {
				path /api/v1/admin/* /api/v1/scanner /api/v1/pregrade
				header Content-Type multipart/form-data*
			}
			request_body @upload {
				max_size 7MB
			}
			request_body @notUpload {
				max_size 256KB
			}

			# Orders, accounts and admin pages carry names and addresses: no browser or proxy may keep them. Only when
			# the backend sets nothing itself, so uploaded images keep their year-long header.
			header ?Cache-Control "no-store"

			reverse_proxy backend:8080
		}

		handle {
			root * /srv
			# Vite puts a hash in the name of every file in /assets, so a file there never changes.
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			header ?Cache-Control "no-cache"
			# Routes of the Vue app, such as /kaarten/pokemon, all get index.html.
			try_files {path} /index.html
			file_server
		}
	}

	# While the backend restarts (a deploy takes about a minute) or is down, a product, drop or news page still gets
	# the app, as every other page does, without its link preview. 503 tells search engines to come back later.
	handle_errors 502 503 504 {
		# The error route sees the address as the visitor asked for it, before the rewrite above.
		@sharePage path_regexp ^/(product|drops|nieuws)/[^/]+$
		handle @sharePage {
			import headers
			header Cache-Control "no-cache"
			header Retry-After "60"
			root * /srv
			rewrite * /index.html
			file_server {
				status 503
			}
		}
	}
}
