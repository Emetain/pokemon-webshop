# The server's .env, at /opt/poketopia/.env. Only the deploy user (and root) can read it. setup.sh creates it from
# this file with a generated database password. Never put the real file in the repository.
#
# The values go to the containers through compose.yml. After a change: /opt/poketopia/bin/compose.sh up -d

# The address of the site, without https://. Caddy gets a Let's Encrypt certificate for it.
# The preview uses <ip-with-dashes>.sslip.io until the legal check clears a name. Phase 10 sets the domain.
SITE_ADDRESS=
# Public address of the shop, for links in mails: https:// and SITE_ADDRESS.
APP_BASE_URL=

# Closed preview: the shared login every page asks for. Make the hash with:
#   docker run --rm caddy:2.11-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes around the hash: it contains $ signs. Phase 10 removes the login.
PREVIEW_USER=poketopia
PREVIEW_PASSWORD_HASH=''

# Database. setup.sh generates the password. Changing it later also needs ALTER USER in Postgres.
POSTGRES_DB=poketopia
POSTGRES_USER=poketopia
POSTGRES_PASSWORD=

# Mail goes to the Mailpit container until phase 10 sets up real mail. Its page is only on the server itself, on
# MAILPIT_PORT. Open it with: ssh -L 8026:127.0.0.1:8025 root@<server>, then http://localhost:8026.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=
MAILPIT_PORT=8025

# Online payment stays off in the preview: leave both empty. Phase 10 adds the live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# When the card sync and the value graph job run, in Dutch time. "-" switches one off.
CATALOG_SYNC_CRON=0 0 3 * * *
COLLECTION_SNAPSHOT_CRON=0 0 7 * * *

# Maximum heap of the backend. The Magic sync needs at least 2g. The container may use about 600 MB more.
BACKEND_HEAP=2g

# Ports of Caddy on the server. Only change them when another program already uses 80 or 443.
HTTP_PORT=80
HTTPS_PORT=443

# The card data sources. The defaults in compose.yml are right: only set one to try another address.
# TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# SCRYFALL_BASE_URL=https://api.scryfall.com
# LORCAST_BASE_URL=https://api.lorcast.com/v0
# OPTCG_BASE_URL=https://optcgapi.com/api
# ECB_BASE_URL=https://www.ecb.europa.eu
# POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# CARDMARKET_PRODUCTS_BASE_URL=https://downloads.s3.cardmarket.com
