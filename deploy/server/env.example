# The server's .env, at /opt/poketopia/.env. Only the deploy user (and root) can read it. setup.sh creates it from
# this file with a generated database password. Never put the real file in the repository.
#
# The values go to the containers through compose.yml. After a change: /opt/poketopia/bin/compose.sh up -d
# Going live (phase 10): fill in the lines marked "go-live" in the order of docs/phases/phase-10.md, and open the shop
# with /opt/poketopia/bin/shop-access.sh open, never by hand.

# Who gets in. "preview" (the default): one shared login for every page, and search engines are kept out. "open":
# the live shop for everyone, with live Stripe keys only. Any other value stops the site. Change it with
# shop-access.sh, which checks the settings below first and asks you to confirm the legal check.
SHOP_ACCESS=preview

# The address of the site, without https://. Caddy gets a Let's Encrypt certificate for it.
# The preview uses <ip-with-dashes>.sslip.io until the legal check clears a name.
# go-live: the domain the shop keeps, for example poketopia.nl (only after its A record points at this server).
SITE_ADDRESS=
# go-live (optional): more addresses, separated by spaces, that redirect to SITE_ADDRESS with a certificate of their
# own. For example www.poketopia.nl, and the old <ip-with-dashes>.sslip.io so old links keep working.
SITE_ALIASES=
# Public address of the shop, for links in mails and Stripe's return page: https:// and SITE_ADDRESS.
APP_BASE_URL=

# Closed preview: the shared login every page asks for. Make the hash with:
#   docker run --rm caddy:2.11-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes around the hash: it contains $ signs. Keep both after opening the shop: they are unused
# then, and going back to the preview stays one switch.
PREVIEW_USER=poketopia
PREVIEW_PASSWORD_HASH=''

# Database. setup.sh generates the password. Changing it later also needs ALTER USER in Postgres.
POSTGRES_DB=poketopia
POSTGRES_USER=poketopia
POSTGRES_PASSWORD=

# Mail goes to the Mailpit container while MAIL_HOST=mailpit. Its page is only on the server itself, on
# MAILPIT_PORT. Open it with: ssh -L 8026:127.0.0.1:8025 root@<server>, then http://localhost:8026.
# go-live: the mail provider's SMTP host and port (usually 587), the login, and both switches on.
MAIL_HOST=mailpit
MAIL_PORT=1025
# go-live: an address on the shop's domain, for example noreply@<domain> or bestellingen@<domain>, so SPF, DKIM and
# DMARC match and mails don't end up in spam.
MAIL_FROM=
MAILPIT_PORT=8025
# With MAIL_SMTP_STARTTLS=true the backend refuses a server that doesn't offer encryption. Put single quotes around
# a password with $ signs in it, as with PREVIEW_PASSWORD_HASH.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Online payment. Empty: off. The preview only takes a test key (sk_test_...), the open shop only a live key
# (sk_live_...): the other kind keeps payment off, and the admin dashboard says why.
# go-live: the live secret key from the Stripe dashboard, and the signing secret (whsec_...) of the webhook endpoint
# https://<domain>/api/v1/payments/stripe/webhook. Never in the repository, the docs or a commit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where new tickets from the contact page are mailed. Empty sends them to MAIL_FROM (Mailpit in the preview).
# go-live: the shared shop mailbox, for example klantenservice@<domain>.
SHOP_EMAIL=

# go-live: the business details in the footer of every page. iDEAL's rules and Dutch law ask for the KVK number on
# the site. Empty shows nothing. COMPANY_LEGAL_NAME only when the registered name isn't just "Poketopia";
# COMPANY_VAT_NUMBER is the btw-id (NL...B..) the Belastingdienst gives for use towards customers. Put the address
# in double quotes, for example "Dorpsstraat 1, 1421 AB Uithoorn".
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_KVK_NUMBER=
COMPANY_VAT_NUMBER=

# Shop checkouts that may wait for payment at once: per customer (the account, or the email address of a guest) and
# per IP address. These are the defaults; raise the second one if customers on one network get refused.
CHECKOUT_MAX_OPEN_PER_CUSTOMER=2
CHECKOUT_MAX_OPEN_PER_IP=5

# Hero slides written by AI and the chatbot on the contact page. Empty hides both. Only the backend reads it. Also
# set a monthly limit in OpenAI's dashboard. The shop stops by itself at OPENAI_MONTHLY_LIMIT_USD for hero slides
# and at OPENAI_CHAT_MONTHLY_LIMIT_USD for the chatbot (US dollars per calendar month).
OPENAI_API_KEY=
OPENAI_MONTHLY_LIMIT_USD=5
OPENAI_CHAT_MONTHLY_LIMIT_USD=3

# When the card sync and the value graph job run, in Dutch time. "-" switches one off.
CATALOG_SYNC_CRON=0 0 3 * * *
RELEASE_SUGGESTION_CRON=0 45 4 * * *
COLLECTION_SNAPSHOT_CRON=0 0 7 * * *

# Maximum heap of the backend. The Magic sync needs at least 2g. The container may use about 600 MB more.
BACKEND_HEAP=2g

# Ports of Caddy on the server. Only change them when another program already uses 80 or 443.
HTTP_PORT=80
HTTPS_PORT=443

# Backups elsewhere and the monitoring pings are not in this file: their secrets are in /opt/poketopia/ops.env, which
# only root can read (template: ops.env.example), so the deploy user can't reach the copies elsewhere.

# The card data sources. The defaults in compose.yml are right: only set one to try another address.
# TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# SCRYFALL_BASE_URL=https://api.scryfall.com
# LORCAST_BASE_URL=https://api.lorcast.com/v0
# OPTCG_BASE_URL=https://optcgapi.com/api
# TCGCSV_BASE_URL=https://tcgcsv.com
# OPENAI_TEXT_MODEL=gpt-6.1-terra
# OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
# ECB_BASE_URL=https://www.ecb.europa.eu
# POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# CARDMARKET_PRODUCTS_BASE_URL=https://downloads.s3.cardmarket.com
