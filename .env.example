# Database
POSTGRES_DB=pokemonwebshop
POSTGRES_USER=pokemonwebshop
POSTGRES_PASSWORD=pokemonwebshop

# Card data sources. All are public APIs that need no key.
# TCGdex: Pokémon cards and Cardmarket prices.
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# Scryfall: Magic: The Gathering cards and Cardmarket prices.
SCRYFALL_BASE_URL=https://api.scryfall.com
# Lorcast: Disney Lorcana cards.
LORCAST_BASE_URL=https://api.lorcast.com/v0
# OPTCG API: One Piece Card Game cards.
OPTCG_BASE_URL=https://optcgapi.com/api
# European Central Bank: exchange rates for showing card prices in another currency.
ECB_BASE_URL=https://www.ecb.europa.eu
# PokéAPI: the list of all Pokémon for the Pokédex.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# Cardmarket's public list of sealed products, for the product import in admin (/admin/producten/import).
# It only runs when an admin starts it. Check the terms during the legal check before going live.
CARDMARKET_PRODUCTS_BASE_URL=https://downloads.s3.cardmarket.com
# When the daily card sync starts, in Dutch time. "-" switches it off.
CATALOG_SYNC_CRON=0 0 3 * * *
# When the value of every collection is saved for the value graph, in Dutch time. "-" switches it off.
# Keep this after the card sync.
COLLECTION_SNAPSHOT_CRON=0 0 7 * * *

# Where uploaded images are stored. A relative path starts at the folder the backend runs in.
MEDIA_DIRECTORY=data/media

# Stripe Checkout for payments (iDEAL, Bancontact, card). Use test keys locally: sk_test_... from
# https://dashboard.stripe.com/test/apikeys. Without a key the shop works, but checkout says online payment is off.
STRIPE_SECRET_KEY=
# Proves a webhook comes from Stripe. Locally: the whsec_... that "stripe listen" prints. In production: the signing
# secret of the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Public address of the frontend. Used for links in emails, and where Stripe sends customers after paying.
APP_BASE_URL=http://localhost:5173

# SMTP server for outgoing mail. Locally Mailpit catches everything, see http://localhost:8025.
MAIL_HOST=localhost
MAIL_PORT=1025
# Sender address of all mails.
MAIL_FROM=noreply@example.com

# Secure flag on the session cookie. Leave unset to use the default per profile:
# off for dev, postgres and docker (plain http on localhost), on for prod.
# AUTH_COOKIE_SECURE=true

# Set to "native" when the backend runs behind a reverse proxy. Rate limiting then sees the
# visitor's real IP address. Without a proxy, keep "none" so nobody can fake the header.
FORWARD_HEADERS_STRATEGY=none
