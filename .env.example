# Database
POSTGRES_DB=pokemonwebshop
POSTGRES_USER=pokemonwebshop
POSTGRES_PASSWORD=pokemonwebshop

# Card data sources. All are public APIs that need no key.
# TCGdex: Pokémon cards and Cardmarket prices.
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# Scryfall: Magic: The Gathering cards and Cardmarket prices.
SCRYFALL_BASE_URL=https://api.scryfall.com
# Lorcast: Disney Lorcana cards.
LORCAST_BASE_URL=https://api.lorcast.com/v0
# OPTCG API: One Piece Card Game cards.
OPTCG_BASE_URL=https://optcgapi.com/api
# TCGCSV: a daily copy of TCGplayer's catalog, for Riftbound cards and prices.
TCGCSV_BASE_URL=https://tcgcsv.com
# European Central Bank: exchange rates for showing card prices in another currency.
ECB_BASE_URL=https://www.ecb.europa.eu
# PokéAPI: the list of all Pokémon for the Pokédex.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# Cardmarket's public list of sealed products, for the product import in admin (/admin/producten/import).
# It only runs when an admin starts it. Check the terms during the legal check before going live.
CARDMARKET_PRODUCTS_BASE_URL=https://downloads.s3.cardmarket.com
# When the daily card sync starts, in Dutch time. "-" switches it off.
CATALOG_SYNC_CRON=0 0 3 * * *
# When the release calendar suggestions are refreshed from the card catalog and TCGplayer. "-" switches it off.
RELEASE_SUGGESTION_CRON=0 45 4 * * *
# When the value of every collection is saved for the value graph, in Dutch time. "-" switches it off.
# Keep this after the card sync.
COLLECTION_SNAPSHOT_CRON=0 0 7 * * *

# Where uploaded images are stored. A relative path starts at the folder the backend runs in.
MEDIA_DIRECTORY=data/media

# Stripe Checkout for payments (iDEAL, Bancontact, card). Use test keys locally: sk_test_... from
# https://dashboard.stripe.com/test/apikeys. Without a key the shop works, but checkout says online payment is off.
STRIPE_SECRET_KEY=
# Proves a webhook comes from Stripe. Locally: the whsec_... that "stripe listen" prints. In production: the signing
# secret of the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Public address of the frontend. Used for links in emails, and where Stripe sends customers after paying.
APP_BASE_URL=http://localhost:5173

# Who gets into the shop: "preview" (the closed preview, the default), "unlisted" (online without the shared login,
# search engines kept out, only admins can order) or "open" (the live shop). On the server Caddy reads it for the
# shared login and robots.txt. The backend only takes a Stripe test key before "open" and a live key with "open", so
# keep "preview" locally.
SHOP_ACCESS=preview

# The business details in the footer of every page (iDEAL and Dutch law ask for the KVK number on the site). Empty
# shows nothing. The legal name only when it isn't just "Poketopia"; the VAT number is the btw-id (NL...B..).
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_KVK_NUMBER=
COMPANY_VAT_NUMBER=

# Ads from Google AdSense on the free card and news pages (never on shop, cart, checkout, drop or account pages).
# "off" (the default) or "adsense". The publisher id (ca-pub- and 16 digits) and the ids of the ad units come from
# the AdSense account; a place without an ad unit shows no ad. Locally the app shows a grey box where an ad would be.
ADS=off
ADSENSE_CLIENT=
ADSENSE_SLOT_CATALOG=
ADSENSE_SLOT_CONTENT=

# Shop checkouts that may wait for payment at once: per customer (the account, or the email address of a guest) and
# per IP address, higher because many people can share one address. These are the defaults.
CHECKOUT_MAX_OPEN_PER_CUSTOMER=2
CHECKOUT_MAX_OPEN_PER_IP=5

# SMTP server for outgoing mail. Locally Mailpit catches everything, see http://localhost:8025.
MAIL_HOST=localhost
MAIL_PORT=1025
# Login and encryption for a real mail provider (usually port 587). Mailpit needs none of them: leave them empty and
# false. With MAIL_SMTP_STARTTLS=true the backend refuses a server that doesn't offer encryption.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Sender address of all mails.
MAIL_FROM=noreply@example.com
# Where new tickets from the contact page (/info/contact) are mailed. Empty sends them to MAIL_FROM. Set it to the
# shared shop mailbox once the shop has its own domain.
SHOP_EMAIL=

# Hero slides written by AI at /admin/hero, and the chatbot on the contact page. Empty switches both off; everything
# else works without it (the contact page then goes straight to the ticket form).
# Backend only: never put this key in a VITE_ variable. Set a monthly limit in OpenAI's dashboard as well.
OPENAI_API_KEY=
# What the shop may spend on OpenAI per calendar month, in US dollars. It stops with a message at this amount.
OPENAI_MONTHLY_LIMIT_USD=5
# The models. The defaults were OpenAI's current ones on 2026-11-12. Change the prices in application.yml with them.
OPENAI_TEXT_MODEL=gpt-6.1-terra
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
# The chatbot: a small, cheap model with its own monthly limit in US dollars, apart from the hero slides.
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_CHAT_MONTHLY_LIMIT_USD=3

# Secure flag on the session cookie. Leave unset to use the default per profile:
# off for dev, postgres and docker (plain http on localhost), on for prod.
# AUTH_COOKIE_SECURE=true

# Set to "native" when the backend runs behind a reverse proxy. Rate limiting then sees the
# visitor's real IP address. Without a proxy, keep "none" so nobody can fake the header.
FORWARD_HEADERS_STRATEGY=none
